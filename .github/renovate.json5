{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices", "schedule:weekly"],
  // That preset types Go module bumps fix, which cliff.toml would file under
  // Fixed and count toward a patch release.
  ignorePresets: [":semanticPrefixFixDepsChoreOthers"],
  semanticCommitType: "chore",
  semanticCommitScope: "deps",
  timezone: "Asia/Tokyo",
  lockFileMaintenance: {
    enabled: true,
  },
  nix: {
    enabled: true,
  },
  postUpdateOptions: ["gomodTidy"],
  packageRules: [
    {
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest", "lockFileMaintenance"],
      automerge: true,
    },
    // A digest update moves gvisor to its master tip, which is not buildable
    // as a Go module; gvisor-tap-vsock bumps pull it along the go branch.
    {
      matchPackageNames: ["gvisor.dev/gvisor"],
      matchUpdateTypes: ["digest"],
      enabled: false,
    },
    // go.sum moves the vendor tree, and a nixpkgs bump can move it too through
    // the Go toolchain that vendors it.
    {
      matchManagers: ["gomod", "nix"],
      postUpgradeTasks: {
        commands: ["nix-update --flake --version=skip sprout"],
        fileFilters: ["flake.nix"],
        executionMode: "branch",
      },
    },
  ],
}
